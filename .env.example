# Copy to .env (optional). Everything works without AI; the coach needs a key.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# PORT=4133
# HOST=0.0.0.0          # default: reachable from the LAN; 127.0.0.1 = this machine only
# ALLOW_REMOTE_SETTINGS=1   # let LAN devices change the AI key/model (host-only by default)
# DATA_DIR=./data
# BOOK_PATH=./docs/your-copy.epub   # defaults to the first .epub in docs/
