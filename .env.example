# Copy to .env (optional). Everything works without AI; the coach needs a key.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# PORT=4133
# HOST=127.0.0.1        # use 0.0.0.0 to reach it from other machines / containers
# DATA_DIR=./data
# BOOK_PATH=./docs/your-copy.epub   # defaults to the first .epub in docs/
