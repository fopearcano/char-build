# Copy to .env (optional). Everything works without AI; the coach needs one provider.

# AI_PROVIDER=anthropic        # anthropic | openai | gemini | openrouter | mistral | groq | deepseek | xai | ollama | lmstudio | custom
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=...
# MISTRAL_API_KEY=...
# GROQ_API_KEY=...
# DEEPSEEK_API_KEY=...
# XAI_API_KEY=...
# OLLAMA_BASE_URL=http://localhost:11434/v1
# CUSTOM_LLM_BASE_URL=http://my-server:8000/v1
# CUSTOM_LLM_API_KEY=...
# Per-provider model override: <PREFIX>_MODEL, e.g. OPENAI_MODEL=gpt-6.1-sol

# PORT=4133
# HOST=0.0.0.0              # default: reachable from the LAN; 127.0.0.1 = this machine only
# ALLOW_REMOTE_SETTINGS=1   # let LAN devices change AI provider/key/model (host-only by default)
# DATA_DIR=./data
# BOOK_PATH=./docs/your-copy.epub   # defaults to the first .epub in docs/

# Language of the sample story seeded on first run: en or it (default: the
# host's LANG, else en). The interface language is picked in the app's menu.
# CHARBUILD_LANG=it
